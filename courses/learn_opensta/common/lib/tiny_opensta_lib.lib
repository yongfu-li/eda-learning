/* Minimal liberty-lite for learn_opensta Part B (OpenSTA 3.x). */
library(tiny_opensta_lib) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1,pf);
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.0;

  slew_lower_threshold_pct : 20.0;
  slew_upper_threshold_pct : 80.0;
  input_threshold_pct_rise : 50.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_rise : 50.0;
  output_threshold_pct_fall : 50.0;

  lu_table_template(delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.1");
    index_2 ("0.01, 0.1");
  }

  cell(AND2) {
    area : 1.0;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(B) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "(A * B)";
      max_capacitance : 0.2;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "1.00, 1.00", \
            "1.00, 1.00" \
          );
        }
        cell_fall(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "1.00, 1.00", \
            "1.00, 1.00" \
          );
        }
        rise_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
        fall_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
      }
      timing() {
        related_pin : "B";
        timing_sense : positive_unate;
        cell_rise(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "1.00, 1.00", \
            "1.00, 1.00" \
          );
        }
        cell_fall(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "1.00, 1.00", \
            "1.00, 1.00" \
          );
        }
        rise_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
        fall_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
      }
    }
  }

  cell(BUF) {
    area : 0.5;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.2;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.50, 0.50", \
            "0.50, 0.50" \
          );
        }
        cell_fall(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.50, 0.50", \
            "0.50, 0.50" \
          );
        }
        rise_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
        fall_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
      }
    }
  }

  cell(INV) {
    area : 0.5;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "(!A)";
      max_capacitance : 0.2;
      timing() {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.50, 0.50", \
            "0.50, 0.50" \
          );
        }
        cell_fall(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.50, 0.50", \
            "0.50, 0.50" \
          );
        }
        rise_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
        fall_transition(delay_template) {
          index_1 ("0.01, 0.1");
          index_2 ("0.01, 0.1");
          values ( \
            "0.01, 0.01", \
            "0.01, 0.01" \
          );
        }
      }
    }
  }
}
